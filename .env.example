SVARASENTRY_MODEL_MODE=baseline
SVARASENTRY_CHECKPOINT=/app/training/checkpoints/model.pt
SVARASENTRY_SAMPLE_RATE=16000
SVARASENTRY_WINDOW_SECONDS=3
SVARASENTRY_STRIDE_SECONDS=1
SVARASENTRY_RISK_ALPHA=0.35
SVARASENTRY_CAUTION_THRESHOLD=0.55
SVARASENTRY_HIGH_THRESHOLD=0.75
# Optional causal explanations. These add extra model passes and are disabled for live latency.
SVARASENTRY_EXPLAIN_OCCLUSION=0
SVARASENTRY_EXPLAIN_BAND_OCCLUSION=0
SVARASENTRY_EXPLAIN_INTEGRATED_GRADIENTS=0
SVARASENTRY_EXPLAIN_TOP_REGIONS=3
# Optional evidence-bound LangChain rewrite. Keep disabled without a provider secret.
SVARASENTRY_LANGCHAIN_ENABLED=0
SVARASENTRY_GROQ_MODEL=openai/gpt-oss-20b
SVARASENTRY_GROQ_TIMEOUT_SECONDS=5
SVARASENTRY_LANGCHAIN_INTERVAL_CHUNKS=5
SVARASENTRY_SESSION_TTL_SECONDS=3600
SVARASENTRY_MAX_SESSIONS=200
SVARASENTRY_MAX_FRAME_BYTES=64000
SVARASENTRY_PAIRING_TOKEN_TTL_SECONDS=120
SVARASENTRY_PAIRING_RECONNECT_TTL_SECONDS=60
SVARASENTRY_FRONTEND_ORIGIN=http://localhost:3000
SVARASENTRY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_PUBLIC_ORIGIN=http://localhost:3000
